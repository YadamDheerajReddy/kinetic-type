# Firebase client config. The SDK is initialized (src/lib/firebase.ts) but not yet used
# anywhere in the app — Auth/Firestore integration is Phase 4 work. Copy this file to
# .env.local and fill in with the values from your Firebase project's Web app config
# (see README "Firebase setup").
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the app at the local Firebase Emulator Suite (npm run
# firebase:emulators) instead of the real project. Only read in dev mode.
VITE_USE_FIREBASE_EMULATORS=false
